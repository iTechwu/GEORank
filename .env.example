# ============================================
# GEOrank — 环境变量配置模板
# 复制本文件为 .env 并填入实际值
# ============================================

# ----- 基础 -----
DEBUG=true
SSO_AUTH_REQUIRED=false
SSO_ISSUER=https://sso.ixicai.cn/api
SSO_CLIENT_ID=georank-dofe-ai
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
SSO_USERINFO_URL=https://sso.ixicai.cn/api/oauth/userinfo
# 生产环境必须改为 false，并使用 HTTPS PUBLIC_BASE_URL 与三组独立随机密钥。
SECRET_KEY=change-me-secret-key
SETTINGS_ENCRYPTION_KEY=change-me-settings-encryption-key
PUBLIC_BASE_URL=http://localhost:3009
# JSON 数组；生产环境仅保留正式域名与内部健康检查所需主机名
TRUSTED_HOSTS=["localhost","127.0.0.1","api","app.georank.com","*.georank.com"]

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=georank
POSTGRES_USER=georank
POSTGRES_PASSWORD=change-me-postgres-password

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
# 连接集中式/远程 Redis 时，可填完整 URL 覆盖（含密码与独立 DB 索引），留空用上面拼出的默认值。
REDIS_URL_EXTERNAL=
CELERY_BROKER_URL_EXTERNAL=

# ----- MCP (Model Context Protocol) -----
# 是否在 /mcp 暴露 MCP 端点（供 AI Agent 调用）；path 可改。
MCP_ENABLED=true
MCP_PATH=/mcp
# 公网 MCP 网关内部信任配置。secret 只在网关和 MCP 服务之间使用，不是用户凭据。
GEORANK_MCP_GATEWAY_SECRET=
GEORANK_MCP_GATEWAY_ONLY=false
GEORANK_MCP_MODELS_BASE_URL=https://ixicai.cn/api/v1
GEORANK_MCP_LLM_MODEL=kimi-k3
GEORANK_MCP_EMBEDDING_MODEL=embedding-vision


# Canonical enterprise knowledge, object and graph infrastructure service.
KNOWLEDGE_API_URL=https://knowledge.dofe.ai/api
KNOWLEDGE_SSO_ISSUER=https://sso.ixicai.cn/api
KNOWLEDGE_SSO_CLIENT_ID=georank-dofe-ai
KNOWLEDGE_SSO_CLIENT_SECRET=
KNOWLEDGE_SSO_SCOPE=service:access
KNOWLEDGE_TENANT_SLUG=yootun
KNOWLEDGE_SPACE_IDS=
# local | shadow | primary. Object and graph writes always use Knowledge.
KNOWLEDGE_READ_MODE=primary
KNOWLEDGE_TIMEOUT_SECONDS=15
KNOWLEDGE_VERIFY_TLS=true

# ----- AI / LLM -----
# 方案一：兼容 OpenAI 格式的第三方服务
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# LLM_MODEL=your-chat-model
#
# 方案二：直连 OpenAI
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://ixicai.cn/api/v1
LLM_MODEL=kimi-k3
# Keep false for SSRF protection. Set true only for trusted self-hosted LLMs on private networks;
# this also permits HTTP endpoints, so restrict network access around the backend service.
ALLOW_PRIVATE_LLM_PROVIDER_URLS=true

# 向后兼容
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Embedding（需单独配置兼容 OpenAI 格式的 Embedding 服务，或留空降级同类推荐） -----
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://ixicai.cn/api/v1
EMBEDDING_MODEL=embedding-vision
EMBEDDING_DIMENSIONS=2048

# ----- JWT -----
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=1440

# ----- 种子账号（可选；留空时 seed 脚本会随机生成一次性密码并打印） -----
GEORANK_SEED_ADMIN_PASSWORD=
GEORANK_SEED_DEMO_PASSWORD=
GEORANK_SEED_TEST_PASSWORD=
